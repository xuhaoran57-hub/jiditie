{
  "name": "wxgame-tideline-core",
  "version": "0.1.0",
  "private": true,
  "description": "潮汐线微信小游戏的 TypeScript 规则、Canvas 表现层、微信适配器、M5 运行时、M6 自有资源与 M7 质量基线",
  "type": "module",
  "scripts": {
    "build": "npm run build:all",
    "build:core": "tsc -p tsconfig.json --noEmit",
    "build:wxgame": "node scripts/build-wxgame.mjs",
    "generate:audio": "node scripts/generate-audio.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "build:all": "npm run build:core && npm run build:wxgame",
    "test": "npm run test:core && npm run test:render && npm run test:platform && npm run test:m5 && npm run test:m7",
    "test:core": "node --experimental-strip-types --test tests/core.test.mjs",
    "test:render": "node --experimental-strip-types --test tests/render.test.mjs",
    "test:platform": "node --experimental-strip-types --test tests/platform.test.mjs",
    "test:m5": "node --experimental-strip-types --test tests/m5.test.mjs",
    "test:m7": "node --experimental-strip-types --test tests/m7.test.mjs",
    "bench:simulation": "node --experimental-strip-types scripts/benchmark-simulation.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:release:strict": "node scripts/check-release.mjs --strict",
    "check": "npm run build:core && npm run check:assets && npm run build:wxgame && npm test && npm run check:release"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
